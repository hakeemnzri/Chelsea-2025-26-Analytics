table 'Player Stats'
	lineageTag: 115b1ae4-abb7-58d8-a435-97af1be5c9ef

	measure 'Players Used' = DISTINCTCOUNT ( 'Player Stats'[player_key] )
		formatString: 0
		displayFolder: Volume
		lineageTag: d41bd9f8-cc8f-59b5-8f0e-9be3ae8a50a2

	measure Appearances = SUM ( 'Player Stats'[pm_appearances] )
		formatString: 0
		displayFolder: Volume
		lineageTag: 7d20f462-3c4b-526f-be28-37624f4be459

	measure Starts = SUM ( 'Player Stats'[pm_starts] )
		formatString: 0
		displayFolder: Volume
		lineageTag: 4899c0d6-4c80-5ffe-b260-b2022090e12d

	measure 'Sub Appearances' = SUM ( 'Player Stats'[pm_sub_appearances] )
		formatString: 0
		displayFolder: Volume
		lineageTag: e3631bee-9a88-5cc1-a8b3-1ec9745e95ff

	measure Minutes = SUM ( 'Player Stats'[pm_minutes] )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 6d5ba1e9-9e78-52a1-8f27-4d5acbe768ca

	measure Goals = SUM ( 'Player Stats'[pm_goals] )
		formatString: 0
		displayFolder: Volume
		lineageTag: dd35fe53-0c40-5ec4-a00a-de5268468bbe

	measure Assists = SUM ( 'Player Stats'[pm_assists] )
		formatString: 0
		displayFolder: Volume
		lineageTag: a571fb32-382f-5296-bed3-5502b701e7e0

	measure 'Goal Contributions' = [Goals] + [Assists]
		formatString: 0
		displayFolder: Volume
		lineageTag: 894743f9-5753-5639-800a-201f901dc247

	measure 'Player xG' = SUM ( 'Player Stats'[pm_xg] )
		formatString: 0.00
		displayFolder: Volume
		lineageTag: f9bbf21d-f6d5-53b3-ad3d-4b3c7e2e006b

	measure 'Player xA' = SUM ( 'Player Stats'[pm_xa] )
		formatString: 0.00
		displayFolder: Volume
		lineageTag: 6d066b2a-024b-5418-9de5-52d7f6e9af18

	measure Shots = SUM ( 'Player Stats'[pm_shots] )
		formatString: 0
		displayFolder: Volume
		lineageTag: 33ff3c76-9261-574e-9162-1a029c3e9a0a

	measure 'Key Passes' = SUM ( 'Player Stats'[pm_key_passes] )
		formatString: 0
		displayFolder: Volume
		lineageTag: edf9e579-b7cc-501f-b28d-5d0c4ade6a8a

	measure 'Yellow Cards' = SUM ( 'Player Stats'[pm_yellow_cards] )
		formatString: 0
		displayFolder: Volume
		lineageTag: 40ff1732-f3bd-502e-8977-b4974a226fc8

	measure 'Red Cards' = SUM ( 'Player Stats'[pm_red_cards] )
		formatString: 0
		displayFolder: Volume
		lineageTag: 9ce200b0-cf9c-546a-9434-e2df4467bed0

	measure 'Goals per 90' = DIVIDE ( [Goals] * 90, [Minutes] )
		formatString: 0.00
		displayFolder: Rates
		lineageTag: 31fbe291-e0d8-59c6-b5c4-53a6c574ecfc

	measure 'G+A per 90' = DIVIDE ( [Goal Contributions] * 90, [Minutes] )
		formatString: 0.00
		displayFolder: Rates
		lineageTag: c7c4ffe8-9d70-5818-841e-4fa2518353c5

	measure 'xG per 90' = DIVIDE ( [Player xG] * 90, [Minutes] )
		formatString: 0.00
		displayFolder: Rates
		lineageTag: 92de6439-b873-5877-90cd-fd571a11cc50

	measure 'Shot Conversion %' = DIVIDE ( [Goals], [Shots] )
		formatString: 0.0%
		displayFolder: Rates
		lineageTag: d4c88544-ad9d-5830-a864-d69fa56842f0

	measure 'Goals vs xG' = [Goals] - [Player xG]
		formatString: +0.00;-0.00;0.00
		displayFolder: Rates
		lineageTag: ab874253-c435-5f9b-9cd6-799cdeef944e

	measure 'Goals (chart)' = IF ( [Goals] > 0, [Goals] )
		formatString: 0
		isHidden
		displayFolder: Chart Helpers
		lineageTag: 2ad9cc8e-5996-52b1-bae8-593c5caf8148

	measure 'Assists (chart)' = IF ( [Assists] > 0, [Assists] )
		formatString: 0
		isHidden
		displayFolder: Chart Helpers
		lineageTag: b7d2d5b3-b9b6-58a4-956a-c850049b6f22

