table Matches
	lineageTag: 7a842386-c7d4-5635-8f0e-9dcccbb2d61d

	measure 'Matches Played' = COUNTROWS ( Matches )
		formatString: 0
		displayFolder: Results
		lineageTag: 2730cc7c-51e6-560b-b768-95a5c2b2cf8c

	measure Wins = IF ( NOT ISEMPTY ( Matches ), COUNTROWS ( FILTER ( Matches, Matches[Result] = "W" ) ) + 0 )
		formatString: 0
		displayFolder: Results
		lineageTag: a5f828cd-8390-51a1-bd58-d6a2e28590df

	measure Draws = IF ( NOT ISEMPTY ( Matches ), COUNTROWS ( FILTER ( Matches, Matches[Result] = "D" ) ) + 0 )
		formatString: 0
		displayFolder: Results
		lineageTag: a1c4bd29-4dea-53ea-9c78-edd89b21c010

	measure Losses = IF ( NOT ISEMPTY ( Matches ), COUNTROWS ( FILTER ( Matches, Matches[Result] = "L" ) ) + 0 )
		formatString: 0
		displayFolder: Results
		lineageTag: 6ca1d6c3-39c3-552c-a3ed-de58e59bb9cb

	measure Record =
			IF (
			    NOT ISEMPTY ( Matches ),
			    [Wins] & "-" & [Draws] & "-" & [Losses]
			)
		displayFolder: Results
		lineageTag: b2643d2b-f9f0-5456-b8bf-c28cf8d1bc72

	measure Points = SUM ( Matches[m_points] )
		formatString: 0
		displayFolder: Results
		lineageTag: 5e54a446-a424-5fff-914a-3018b9ba3cfc

	measure 'Points per Game' = DIVIDE ( [Points], [Matches Played] )
		formatString: 0.00
		displayFolder: Results
		lineageTag: 356fbcee-acfc-5f58-9961-2b678acafc54

	measure 'Win %' = DIVIDE ( [Wins], [Matches Played] )
		formatString: 0.0%
		displayFolder: Results
		lineageTag: d5fd7eca-9465-51bb-8850-48cc13fa48a9

	measure 'Form (Last 5)' =
			VAR LastFive = TOPN ( 5, Matches, Matches[Match Date], DESC )
			RETURN
			    CONCATENATEX ( LastFive, Matches[Result], " ", Matches[Match Date], ASC )
		displayFolder: Results
		lineageTag: 38a93b65-b446-5318-b1d8-8ebdc60e8688

	measure 'Cumulative Points' =
			VAR CurrentDate = MAX ( Matches[Match Date] )
			RETURN
			    CALCULATE (
			        [Points],
			        FILTER ( ALLSELECTED ( Matches[Match Date] ), Matches[Match Date] <= CurrentDate )
			    )
		formatString: 0
		displayFolder: Results
		lineageTag: a56754eb-8eec-5c28-bfdf-268339c92ee4

	measure 'Goals For' = SUM ( Matches[m_goals_for] )
		formatString: 0
		displayFolder: Goals
		lineageTag: 9cc77e7b-985e-5b44-9030-bda9983acaa4

	measure 'Goals Against' = SUM ( Matches[m_goals_against] )
		formatString: 0
		displayFolder: Goals
		lineageTag: 34909654-5b61-5200-83b3-f8da7cc75354

	measure 'Goal Difference' = [Goals For] - [Goals Against]
		formatString: +0;-0;0
		displayFolder: Goals
		lineageTag: 05c0608a-843f-5fb9-a5a8-6f2ab04a5960

	measure 'Goals For per Game' = DIVIDE ( [Goals For], [Matches Played] )
		formatString: 0.00
		displayFolder: Goals
		lineageTag: 4108f067-d167-5ea2-b8cb-d28c9ce8de60

	measure 'Goals Against per Game' = DIVIDE ( [Goals Against], [Matches Played] )
		formatString: 0.00
		displayFolder: Goals
		lineageTag: 9c58d86d-0464-587b-8c83-8a0c4a1870df

	measure 'Clean Sheets' = IF ( NOT ISEMPTY ( Matches ), COUNTROWS ( FILTER ( Matches, Matches[m_goals_against] = 0 ) ) + 0 )
		formatString: 0
		displayFolder: Goals
		lineageTag: 7df795b4-cc8f-5bb3-91f0-3abb4a181f7f

	measure 'xG For' = SUM ( Matches[m_xg_for] )
		formatString: 0.00
		displayFolder: Expected Goals
		lineageTag: a2370e42-c426-5da7-b10a-6b8e8c3975f5

	measure 'xG Against' = SUM ( Matches[m_xg_against] )
		formatString: 0.00
		displayFolder: Expected Goals
		lineageTag: e23fffd0-26d2-55b1-9aaa-11134de66901

	measure 'xG Difference' = IF ( NOT ISBLANK ( [xG For] ), [xG For] - [xG Against] )
		formatString: +0.00;-0.00;0.00
		displayFolder: Expected Goals
		lineageTag: 67ef8a8a-ca74-564d-a761-cbae42f4fac9

	measure 'Goals For vs xG' =
			-- Compares only matches that have xG, so cup goals don't inflate the gap
			VAR GoalsInXgMatches =
			    CALCULATE ( [Goals For], KEEPFILTERS ( NOT ISBLANK ( Matches[m_xg_for] ) ) )
			RETURN
			    IF ( NOT ISBLANK ( [xG For] ), GoalsInXgMatches - [xG For] )
		formatString: +0.00;-0.00;0.00
		displayFolder: Expected Goals
		lineageTag: 49b95cb4-b63c-5018-81cb-d755571ce5ef

	measure 'Avg Possession %' = DIVIDE ( AVERAGE ( Matches[m_possession_pct] ), 100 )
		formatString: 0.0%
		displayFolder: Match Info
		lineageTag: fd31d173-718c-5938-a000-626a3e3e29ae

	measure 'Avg Attendance' = AVERAGE ( Matches[m_attendance] )
		formatString: #,0
		displayFolder: Match Info
		lineageTag: 64d86533-6b20-5d90-a4f9-d2e9396bf669

